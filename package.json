{
  "name": "mini4wd-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:bey": "tsc -b && vite build -c vite.bey.config.ts && node -e \"require('fs').renameSync('dist-bey/bey.html','dist-bey/index.html')\"",
    "build:bey-personal": "tsc -b && vite build -c vite.bey-personal.config.ts && node -e \"require('fs').renameSync('dist-bey-personal/bey-personal.html','dist-bey-personal/index.html')\""
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "peerjs": "^1.5.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
